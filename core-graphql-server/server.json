{
  "flyway": {
    "migrate": false,
    "validateOnMigrate": false,
    "validateOnMigrate.comment": "Once validateOnMigrate is true, the system will check validateOnMigrate for each DB, somthing is like flyway.db.sso.validateOnMigrate, ... (by default, validateOnMigrate for each DB is true)"
  },
  "featureFlags": {
    "enableRBACFeature": true,
    "v2FoldersAvailable": true,
    "enablePackageGrantLogic": true,
    "enableBatchActionsAPI": true,
    "canExportLogsOlderThan12Months": true,
    "enableDefaultDesktopApp": true,
    "virtualAssetEnabled": true
  },
  "log": {
    "level": "debug"
  },
  "taskTablePartitionActiveDate": "2018-07-29T00:00:00.000Z",
  "jobTablePartitionActiveDate": "2018-07-29T00:00:00.000Z",
  "recordingAssetTablePartitionActiveDate": "2018-10-22T00:00:00.000Z",
  "sharedUrlPartitionActiveDate": "2018-12-16T00:00:00.000Z",
  "recordingWeekConfig": {
    "weeklyIdsDateActive": "2018-10-22T00:00:00.000Z",
    "weekOffset": 20
  },
  "nodeEnv": "local",
  "port": 3000,
  "server": {
    "rateLimit": {
      "intervalRequestLimit": 1000,
      "tokenRequestLimit": 100
