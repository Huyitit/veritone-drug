  "scripts": {
    "build": "ncc build server.js -o dist --v8-cache",
    "start": "sh start.sh",
    "serve": "node --max_old_space_size=1978 server.js",
    "citest": "./node_modules/.bin/jest --projects citest --testTimeout=70000 --runInBand",
    "citest:nightly:tagged": "./node_modules/.bin/jest --projects citest --testTimeout=70000 --runInBand -t '@nightly'",
    "test": "jest --coverage --coverageDirectory=coverage --maxWorkers=${JEST_MAX_WORKERS:-50%}",
    "testfast": "jest --bail --collectCoverage=false --maxWorkers=${JEST_MAX_WORKERS:-50%}",
    "lint": "biome check . --no-errors-on-unmatched",
    "docs": "sh make_graphqldocs.sh",
    "test_flyway": "sh test_flyway_scripts.sh",
    "stubconfig": "node ./config/init/stubConfigGenerator.js",
    "precommit": "pnpm run lint && pnpm run test && sh test_flyway_scripts_ifchanged.sh"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/_instrumented/",
      "/citest/"
    ],
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/citest/",
      "/test/",
      "/modules/core-media-server/",
      "/modules/core-collection-server/",
      "/_instrumented/",
      "/flyway/"
    ],
    "collectCoverageFrom": [
      "*.js",
      "bll/**/*.js",
      "dal/**/*.js",
      "loaders/**/*.js",
      "modules/**/*.js",
      "resolvers/**/*.js",
      "routes/**/*.js",
      "schema/**/*.js",
      "sdoAdapter/**/*.js",
      "util/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 74,
        "branches": 65,
        "lines": 74,
        "functions": 73
      }
    },
    "coverageReporters": [
      "text",
      "json-summary",
      "lcov",
      "cobertura"
    ],
    "reporters": [
      "default",
      "jest-junit"
    ],
    "testTimeout": 15000,
    "workerIdleMemoryLimit": "1536MB",
    "transform": {},
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "jest-junit": {
    "suiteName": "core-graphql-server",
    "output": "junit/junit.xml",
    "classNameTemplate": "{classname}-{title}",
    "titleTemplate": "{classname}-{title}",
    "ancestorSeparator": " › ",
    "usePathForSuiteName": "true"
  }
}
